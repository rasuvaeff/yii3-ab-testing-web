{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "testFramework": "testo",
    "testFrameworkOptions": "--suite=Unit",
    // 1 equivalent mutant: CookieAssignmentStore::decode() early `return []` when
    // `!$signer->isSigned($cookie)` — removing it lets code fall through to
    // `validate()` which throws RuntimeException, caught and `return []` anyway.
    "minMsi": 98,
    "mutators": {
        "@default": true
    }
}
